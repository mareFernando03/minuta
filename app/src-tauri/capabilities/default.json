{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal y del panel de la bandeja",
  "windows": [
    "main",
    "panel"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "ms-settings:sound*"
        }
      ]
    },
    "autostart:default",
    "core:window:allow-start-dragging",
    "notification:default"
  ]
}
