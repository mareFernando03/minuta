{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minuta",
  "version": "0.9.5",
  "identifier": "ar.fmare.minuta",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minuta",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main",
        "visible": false,
        "center": true
      },
      {
        "label": "panel",
        "title": "Minuta",
        "url": "index.html#panel",
        "width": 340,
        "height": 430,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": true,
        "maximizable": false,
        "minimizable": false,
        "contentProtected": true
      },
      {
        "label": "dictado",
        "title": "Minuta: dictado",
        "url": "index.html#dictado",
        "width": 220,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "minuta"
        ]
      }
    }
  }
}
